# Built application files
*.apk
*.aar
*.ap_
*.aab
# Files for the ART/Dalvik VM
*.dex
# Java class files
*.class
# Generated files
bin/
gen/
out/
# App Release Files
app/release/*
# Gradle files
.gradle/
build/
# ATAK takdev plugin scratch dir (generated: resolved aars + plugin.properties
# with per-build timestamp/hashes)
.takdev/
# Local configuration file (sdk path, etc)
local.properties
# Proguard folder generated by Eclipse
proguard/
# Log Files
*.log
# Android Studio Navigation editor temp files
.navigation/
temp/
# Android Studio captures folder
captures/
# IntelliJ
*.iml
.idea/
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml
# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
*.jks
*.keystore
# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/
# Google Services (e.g. APIs or Firebase)
google-services.json
# Version control
vcs.xml
# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/
# MacOS
.DS_Store
# App Specific cases
app/release/output.json
.idea/codeStyles/
# Kotlin
.kotlin

# Whisper on-device transcription assets (fetched by scripts/fetch_whisper.sh,
# not committed: large vendored source + binary model). Run the script to
# regenerate before building.
/app/src/main/cpp/whisper.cpp/
/app/src/main/assets/models/
/app/src/main/assets/jfk.wav
